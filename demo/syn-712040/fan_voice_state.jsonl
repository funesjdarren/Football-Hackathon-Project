{"clock": "00:00", "lang": "ko", "fallback": false, "agent": "MS-Football-Hackathon-Fan-Voice", "agent_version": "1", "written_at": "2026-10-25T20:46:48.410534+00:00", "text": "\uacbd\uae30\uac00 \uc2dc\uc791\ub410\uc2b5\ub2c8\ub2e4! \uacbd\uae30 \ud750\ub984 \ud574\uc124\uc740 15\ubd84\ub9c8\ub2e4, \ud558\ud504\ud0c0\uc784\uacfc \uacbd\uae30 \uc885\ub8cc \ub54c, \uadf8\ub9ac\uace0 \uace8\uacfc \ub808\ub4dc\uce74\ub4dc \uc9c1\ud6c4\uc5d0 \uc804\ud574\uc9d1\ub2c8\ub2e4.\n", "label": "\ud0a5\uc624\ud504", "next": "\ub2e4\uc74c \uc5c5\ub370\uc774\ud2b8: 15' (\uace8\uc774\ub098 \ub808\ub4dc\uce74\ub4dc\uac00 \ub098\uc624\uba74 \ub354 \uc77c\ucc0d)"}
{"clock": "15:02", "lang": "ko", "fallback": false, "agent": "MS-Football-Hackathon-Fan-Voice", "agent_version": "1", "written_at": "2026-10-25T20:50:57.841978+00:00", "text": "\uc544\uc9c1 0-0\uc774\uace0, \uc591 \ud300 \ubaa8\ub450 \uc9c0\uae08\uae4c\uc9c0 \ud070 \uae30\ud68c\ub97c \ub9ce\uc774 \ub9cc\ub4e4\uc9c4 \ubabb\ud588\uc5b4\uc694. Beta United\uac00 \uc804\uccb4\uc801\uc73c\ub85c \uacf5\uc744 \ub354 \ub9ce\uc774 \uc18c\uc720\ud558\uba70 \uc704\ud611\uc801\uc778 \uc7a5\uba74\ub3c4 \uc870\uae08 \ub354 \ub9cc\ub4e4\uc5c8\uc9c0\ub9cc, \ucd5c\uadfc \uc720\ud6a8 \uc288\ud305\uc740 Alpha\uac00 \uae30\ub85d\ud588\uc5b4\uc694. Beta United\uc758 \uc810\uc720\uac00 \ub354 \uba85\ud655\ud55c \uae30\ud68c\ub85c \uc774\uc5b4\uc9c8\uc9c0 \uc9c0\ucf1c\ubcf4\uc138\uc694.\n\uae30\ub300 \ub4dd\uc810(xG): \ud300\uc758 \uae30\ud68c\uac00 \uace8\ub85c \uc774\uc5b4\uc9c8 \uac00\ub2a5\uc131\uc744 \ucd94\uc815\ud55c \uc218\uce58\uc608\uc694.", "label": "15\ubd84 \uc0c1\ud669 \uc810\uac80", "next": "\ub2e4\uc74c \uc5c5\ub370\uc774\ud2b8: 30' (\uace8\uc774\ub098 \ub808\ub4dc\uce74\ub4dc\uac00 \ub098\uc624\uba74 \ub354 \uc77c\ucc0d)"}
{"clock": "30:04", "lang": "ko", "fallback": false, "agent": "MS-Football-Hackathon-Fan-Voice", "agent_version": "1", "written_at": "2026-10-25T20:55:14.711612+00:00", "text": "\uc5ec\uc804\ud788 0-0\uc785\ub2c8\ub2e4. Alpha\uac00 \uc804\uccb4 \uc288\ud305\uc740 \ub354 \ub9ce\uc774 \ud588\uc9c0\ub9cc \uc591 \ud300 \ubaa8\ub450 \ub4dd\uc810\uc73c\ub85c \uc5f0\uacb0\ud558\uc9c0 \ubabb\ud588\uace0, \ucd5c\uadfc \ud750\ub984\uc744 \ud3ec\ud568\ud574 \uc810\uc720\uc728\uc740 Beta\uac00 \uc55e\uc11c\ub294 \uac00\uc6b4\ub370 \uacbd\uae30 \uc804\uccb4 \uc288\ud305\uc740 Alpha\uac00 6\uac1c, Beta\uac00 1\uac1c\uc785\ub2c8\ub2e4. Beta\uc758 \uc810\uc720\uc728 \uc6b0\uc704\uac00 \ub354 \uc88b\uc740 \uae30\ud68c\ub85c \uc774\uc5b4\uc9c8\uc9c0 \uc9c0\ucf1c\ubcf4\uc138\uc694.\n\uae30\ub300 \ub4dd\uc810(xG): \ud300\uc758 \ub4dd\uc810 \uae30\ud68c\uac00 \uace8\ub85c \uc774\uc5b4\uc9c8 \uac00\ub2a5\uc131\uc744 \ucd94\uc815\ud55c \uc218\uce58\uc785\ub2c8\ub2e4.", "label": "30\ubd84 \uc0c1\ud669 \uc810\uac80", "next": "\ub2e4\uc74c \uc5c5\ub370\uc774\ud2b8: \ud558\ud504\ud0c0\uc784 (\uace8\uc774\ub098 \ub808\ub4dc\uce74\ub4dc\uac00 \ub098\uc624\uba74 \ub354 \uc77c\ucc0d)"}
{"clock": "48:00 +3", "lang": "ko", "fallback": false, "agent": "MS-Football-Hackathon-Fan-Voice", "agent_version": "1", "written_at": "2026-10-25T21:00:36.963653+00:00", "text": "\uc804\ubc18\uc740 \ub4dd\uc810 \uc5c6\uc774 \ub05d\ub0ac\uc9c0\ub9cc, Alpha\uac00 \ub354 \ub9ce\uc740 \uae30\ud68c\ub97c \ub9cc\ub4e4\uc5c8\uace0 \ub9c9\ud310\uc5d0\ub294 \uc555\ubc15\uc744 \uc774\uc5b4 \uac14\uc2b5\ub2c8\ub2e4. Beta\ub294 \uc810\uc720\uc728\uc774 \ub354 \ub192\uc558\uc9c0\ub9cc \ucd5c\uadfc\uc5d0\ub294 \uace8\ubb38\uc744 \uc704\ud611\ud558\uc9c0 \ubabb\ud588\uace0, Alpha\uc758 \uae30\ub300 \ub4dd\uc810(xG)\uc774 \uc57d 1\uc774\ub77c \ub9ac\ub4dc\ub97c \uc7a1\uc9c0 \ubabb\ud55c \uac8c \uc544\uc26c\uc6b8 \ub9cc\ud569\ub2c8\ub2e4. Alpha\ub294 \ub9c8\ubb34\ub9ac\ub97c \ub354 \ub0a0\uce74\ub86d\uac8c \ud574\uc57c \ud558\uace0, Beta\ub294 \uc810\uc720\uc728\uc744 \ub354 \uc88b\uc740 \uae30\ud68c\ub85c \uc5f0\uacb0\ud574\uc57c \ud569\ub2c8\ub2e4.\n\uae30\ub300 \ub4dd\uc810(xG): \ud55c \ud300\uc758 \uae30\ud68c\ub4e4\uc774 \ubcf4\ud1b5 \uba87 \uace8\ub85c \uc774\uc5b4\uc9c8\uc9c0 \ucd94\uc815\ud55c \uc218\uce58\uc785\ub2c8\ub2e4.", "label": "\ud558\ud504\ud0c0\uc784", "next": "\ub2e4\uc74c \uc5c5\ub370\uc774\ud2b8: 60' (\uace8\uc774\ub098 \ub808\ub4dc\uce74\ub4dc\uac00 \ub098\uc624\uba74 \ub354 \uc77c\ucc0d)"}
{"clock": "60:02", "lang": "ko", "fallback": false, "agent": "MS-Football-Hackathon-Fan-Voice", "agent_version": "1", "written_at": "2026-10-25T21:04:40.000354+00:00", "text": "Beta United\uac00 M. Halvard\uc758 \uc120\uc81c\uace8\ub85c 1-0 \uc55e\uc11c\uace0 \uc788\uc5b4\uc694. \uacbd\uae30 \uc804\uccb4\ub85c\ub294 Alpha\uac00 \ub354 \ub9ce\uc740 \uae30\ud68c\ub97c \ub9cc\ub4e4\uc5c8\uc9c0\ub9cc, \ucd5c\uadfc \uace8\uc744 \ub123\uc740 Beta\uac00 \uc9c0\uae08 \ud750\ub984\uc5d0\uc11c \uc55e\uc11c \uc788\uc5b4\uc694. Alpha\uac00 \uc555\ubc15\uc744 \ub3d9\uc810\uace8\ub85c \uc5f0\uacb0\ud560 \uc218 \uc788\uc744\uc9c0 \uc9c0\ucf1c\ubcf4\uc138\uc694.\n\uae30\ub300 \ub4dd\uc810(xG): \ud55c \ud300\uc758 \uae30\ud68c\ub4e4\uc774 \ubcf4\ud1b5 \uba87 \uace8\uc744 \ub9cc\ub4e4\uc5b4\ub0bc\uc9c0 \ucd94\uc815\ud55c \uc218\uce58\uc608\uc694.", "label": "60\ubd84 \uccb4\ud06c\uc778", "next": "\ub2e4\uc74c \uc5c5\ub370\uc774\ud2b8: 75' (\uace8\uc774\ub098 \ub808\ub4dc\uce74\ub4dc\uac00 \ub098\uc624\uba74 \ub354 \uc77c\ucc0d)"}
{"clock": "75:10", "lang": "ko", "fallback": false, "agent": "MS-Football-Hackathon-Fan-Voice", "agent_version": "1", "written_at": "2026-10-25T21:08:50.310801+00:00", "text": "Beta United\uac00 \ud6c4\ubc18 Halvard\uc758 \uace8\ub85c 1-0 \uc55e\uc11c\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc804\uccb4\uc801\uc73c\ub85c\ub294 Alpha\uac00 \uc288\ud305 17-11\ub85c \uc55e\uc130\uc9c0\ub9cc, \ucd5c\uadfc \ud750\ub984\uc5d0\uc11c\ub294 Beta United\uac00 \uc810\uc720\uc728\uacfc \uc288\ud305\uc5d0\uc11c \uc6b0\uc138\ud569\ub2c8\ub2e4. Alpha\uac00 \uc55e\uc11c \ub9cc\ub4e0 \uae30\ud68c\ub97c \ub3d9\uc810\uace8\ub85c \uc5f0\uacb0\ud560 \uc218 \uc788\uc744\uc9c0 \uc9c0\ucf1c\ubcf4\uc138\uc694.\n\uae30\ub300 \ub4dd\uc810(xG): \ud55c \ud300\uc758 \uae30\ud68c\ub4e4\uc774 \ubcf4\ud1b5 \uba87 \uace8\uc744 \ub9cc\ub4e4\uc5b4\ub0bc\uc9c0 \ucd94\uc815\ud558\ub294 \uc218\uce58\uc785\ub2c8\ub2e4.", "label": "75\ubd84 \uc810\uac80", "next": "\ub2e4\uc74c \uc5c5\ub370\uc774\ud2b8: \ud480\ud0c0\uc784 (\uace8\uc774\ub098 \ub808\ub4dc\uce74\ub4dc\uac00 \ub098\uc624\uba74 \ub354 \uc77c\ucc0d)"}
{"clock": "95:00 +5", "lang": "ko", "fallback": false, "agent": "MS-Football-Hackathon-Fan-Voice", "agent_version": "1", "written_at": "2026-10-25T21:14:38.684812+00:00", "text": "Beta United\uac00 1-0\uc73c\ub85c \uc774\uacbc\uc2b5\ub2c8\ub2e4. \ud6c4\ubc18 Halvard\uc758 \uace8\uc774 \uc2b9\ubd80\ub97c \uac08\ub790\uace0, Alpha\ub294 \uc288\ud305 \uc218\uc640 \uae30\ub300 \ub4dd\uc810(xG)\uc5d0\uc11c \uc55e\uc11c \ub354 \uc88b\uc740 \uae30\ud68c\ub97c \ub9cc\ub4e0 \uac83\uc73c\ub85c \ubcf4\uc600\uc9c0\ub9cc \ub9c8\ubb34\ub9ac\ud558\uc9c0 \ubabb\ud588\uc2b5\ub2c8\ub2e4. Beta\ub294 \ub354 \ub192\uc740 \uacb0\uc815\ub825\uc744 \ubcf4\uc600\uace0, Alpha\uc5d0\uac90 \uc544\uc26c\uc6b4 \uacb0\uacfc\uc9c0\ub9cc \uace8\uc744 \ub123\uc740 \ud300\uc774 \uc2b9\ub9ac\ud588\uc2b5\ub2c8\ub2e4.\n\uae30\ub300 \ub4dd\uc810(xG): \ud574\ub2f9 \ud300\uc758 \uae30\ud68c\uc640 \ube44\uc2b7\ud55c \uae30\ud68c\ub4e4\uc774 \ubcf4\ud1b5 \uba87 \uace8\uc744 \ub9cc\ub4e4\uc5b4\ub0b4\ub294\uc9c0 \ucd94\uc815\ud55c \uc218\uce58\uc785\ub2c8\ub2e4.", "label": "\uacbd\uae30 \uc885\ub8cc", "next": "\ud480\ud0c0\uc784: \uc774\ubc88 \uacbd\uae30\uc758 \ub9c8\uc9c0\ub9c9 \uacbd\uae30 \ud750\ub984 \uc5c5\ub370\uc774\ud2b8\uc600\uc2b5\ub2c8\ub2e4."}
